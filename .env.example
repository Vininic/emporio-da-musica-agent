# At least one key. With both, OpenRouter is the automatic fallback.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Required on Vercel: signs conversation tokens, shared by all instances
STATE_SECRET=

# Optional
# RATE_LIMIT_PER_MINUTE=20
# LLM_PROVIDER=gemini
# CHAT_MODEL=gemini-3.5-flash-lite
# STORE_NOW=2026-03-25T10:30:00
